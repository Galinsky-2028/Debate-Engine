FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates clamav-daemon clamav-freshclam tini \
    && rm -rf /var/lib/apt/lists/* \
    && usermod -aG clamav node
WORKDIR /app
COPY --from=build --chown=node:node /app /app
COPY ops/clamd.conf /etc/clamav/clamd.conf
COPY ops/freshclam.conf /etc/clamav/freshclam.conf
COPY scripts/start-production.sh /usr/local/bin/start-production
RUN chmod 755 /usr/local/bin/start-production
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    CLAMD_SOCKET_PATH=/run/clamav/clamd.ctl NODE_OPTIONS=--max-old-space-size=384
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/start-production"]

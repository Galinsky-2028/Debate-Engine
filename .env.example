DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
PLATFORM_ADMIN_USER_IDS=
MEDIA_BUCKET=debate-originals
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional exact HTTPS origin for production cookie mutation requests
PUBLIC_APP_ORIGIN=

# Required before accepting candidate audio/video originals
CLAMD_SOCKET_PATH=

# Optional generic HTTPS JSON email provider for notices/invitations/distribution.
# When unset, email deliveries stay queued (last_error=provider_unconfigured) and are never reported sent.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Optional budgets. Unset = no cap configured; an invalid value fails closed (treated as 0).
MEDIA_STORAGE_BUDGET_BYTES=
RENDER_BUDGET_SECONDS_PER_DAY=

# Local integration tests only; ignored when NODE_ENV=production.
PDE_ALLOW_LOOPBACK_WEBHOOKS=
